// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COMPRADOR
  FORNECEDOR
}

enum Perfil {
  SECRETARIO_SAUDE
  GESTOR_ESTOQUE
  FARMACIA
  MEDICO
  ENTREGADOR
  POSTO_SAUDE
  REGULADOR
  RECEPCIONISTA_UBS
  GESTOR_UBS
}

enum UsuarioStatus {
  PENDENTE
  ATIVO
  RECUSADO
  DESATIVADO
}

enum PedidoStatus {
  RASCUNHO
  PENDENTE
  APROVADO
  EM_TRANSITO
  ENTREGUE
  CANCELADO
  ACEITO
  REJEITADO
}

enum AtaStatus {
  ATIVA
  VENCIDA
  CANCELADA
  EM_REVISAO
  ESGOTADA
}

enum NotaFiscalStatus {
  PENDENTE
  CONFERIDA
  CONFERIDO_DIVERGENCIA
  CANCELADA
}

enum CdEstoqueLoteStatus {
  DISPONIVEL
  BLOQUEADO_RECALL
  ESGOTADO
  VENCIDO
}

enum AlertaCdTipo {
  DIVERGENCIA_NF
  RECALL
  ESTOQUE_MINIMO
}

enum AlertaCdStatus {
  NOVO
  LIDO
  RESOLVIDO
}

enum StatusAgendamento {
  AGUARDANDO_ATENDIMENTO_MEDICO
  AGUARDANDO_REGULACAO
  PRE_AGENDADO
  AGUARDANDO_RESPOSTA_PACIENTE
  CONFIRMADO
  CANCELADO
}

enum TipoAtendimento {
  SUS
  PARCERIA
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  PREFIRO_NAO_INFORMAR
}

// ─── Bases oficiais de preço (carregadas pelo ETL externo) ───────────────────
// Estas tabelas NÃO são escritas pela aplicação — só lidas, em
// precoReferencia.service.ts. Estão declaradas aqui porque, sem isso, o Prisma
// as considera tabelas estranhas ao schema e um `db push` as removeria,
// levando junto ~425 MB de dados oficiais.

/// Banco de Preços em Saúde: preços que órgãos públicos efetivamente pagaram.
/// `preco_unitario` já é por unidade de fornecimento.
/// Atenção: `codigo_br` aqui é o código de material do ComprasNet (ex.: 393138),
/// que NÃO é o mesmo do código BR do CATMAT (ex.: BR0270558-2). Por isso o elo
/// entre as bases é feito por princípio ativo, não por código.
model EtlBps {
  id                            BigInt   @id @default(autoincrement())
  registroHash                  String   @unique @map("registro_hash")
  anoCompra                     Int      @map("ano_compra")
  nomeInstituicao               String   @map("nome_instituicao")
  esfera                        String
  cnpjInstituicao               String   @map("cnpj_instituicao")
  municipioInstituicao          String   @map("municipio_instituicao")
  uf                            String
  compra                        DateTime @db.Date
  insercao                      DateTime @db.Date
  codigoBr                      String   @map("codigo_br")
  descricaoCatmat               String   @map("descricao_catmat")
  unidadeFornecimento           String   @map("unidade_fornecimento")
  generico                      Boolean?
  anvisa                        String?
  modalidadeCompra              String   @map("modalidade_compra")
  tipoCompra                    String   @map("tipo_compra")
  capacidade                    Decimal?
  unidadeMedida                 String?  @map("unidade_medida")
  unidadeFornecimentoCapacidade String   @map("unidade_fornecimento_capacidade")
  cnpjFornecedor                String   @map("cnpj_fornecedor")
  fornecedor                    String
  cnpjFabricante                String   @map("cnpj_fabricante")
  fabricante                    String
  qtdItensComprados             BigInt   @map("qtd_itens_comprados")
  precoUnitario                 Decimal  @map("preco_unitario")
  precoTotal                    Decimal  @map("preco_total")
  quantidadeComprimidosCaixa    Int?     @map("quantidade_comprimidos_caixa")
  extraidoEm                    DateTime @default(now()) @map("extraido_em") @db.Timestamp(6)
  arquivoOrigem                 String   @map("arquivo_origem")

  @@index([codigoBr])
  @@index([anoCompra])
  @@index([anvisa])
  @@index([cnpjFornecedor])
  @@index([cnpjInstituicao])
  @@index([compra])
  @@index([uf])
  @@map("etl_bps")
}

/// Catálogo de medicamentos regulados pela CMED (um registro por apresentação).
model EtlCmed {
  codigoGgrem         String   @id @map("codigo_ggrem")
  registro            String
  ean1                String?  @map("ean_1")
  ean2                String?  @map("ean_2")
  ean3                String?  @map("ean_3")
  substancia          String?
  produto             String?
  apresentacao        String?
  cnpj                String
  laboratorio         String?
  classeTerapeutica   String?  @map("classe_terapeutica")
  tipoProduto         String?  @map("tipo_produto")
  regimeDePreco       String?  @map("regime_de_preco")
  restricaoHospitalar Boolean? @map("restricao_hospitalar")
  cap                 Boolean?
  confaz87            Boolean? @map("confaz_87")
  icms0Percentual     Boolean? @map("icms_0_percentual")
  analiseRecursal     String?  @map("analise_recursal")
  creditoTributario   String?  @map("credito_tributario")
  comercializado      Boolean?
  anoComercializacao  Int?     @map("ano_comercializacao")
  tarja               String?
  publicadoEm         DateTime @map("publicado_em") @db.Timestamp(6)
  extraidoEm          DateTime @map("extraido_em") @db.Timestamp(6)
  arquivoOrigem       String   @map("arquivo_origem")

  precos EtlCmedPreco[]

  @@index([produto])
  @@index([ean1])
  @@index([registro])
  @@map("etl_cmed")
}

/// Série histórica de preços CMED. `tipo_preco` é PF (Preço Fábrica) ou
/// PMVG (Preço Máximo de Venda ao Governo) — este último é o teto legal em
/// compra pública, publicado POR APRESENTAÇÃO, não por unidade.
model EtlCmedPreco {
  id              BigInt   @id @default(autoincrement())
  codigoGgrem     String   @map("codigo_ggrem")
  medicamento     EtlCmed  @relation(fields: [codigoGgrem], references: [codigoGgrem])
  publicadoEm     DateTime @map("publicado_em") @db.Timestamp(6)
  tipoPreco       String   @map("tipo_preco")
  aliquotaIcms    Decimal? @map("aliquota_icms")
  alc             Boolean
  semImpostos     Boolean  @map("sem_impostos")
  valor           Decimal
  possuiAsterisco Boolean  @map("possui_asterisco")
  extraidoEm      DateTime @map("extraido_em") @db.Timestamp(6)

  @@unique([codigoGgrem, publicadoEm, tipoPreco, aliquotaIcms, alc, semImpostos])
  @@index([codigoGgrem])
  @@index([publicadoEm])
  @@index([tipoPreco])
  @@map("etl_cmed_precos")
}

/// Catálogo CATMAT de medicamentos, mantido pelo processo de ETL externo.
/// Substitui a antiga tabela `catmat_medicamentos`, que ficou vazia e era
/// mais pobre (não tinha princípio ativo, concentração nem forma farmacêutica).
/// Atenção: `codigo_br` NÃO é único aqui — a unicidade real é a combinação
/// (codigo_br, principio_ativo, concentracao, forma_farmaceutica,
/// unidade_fornecimento), pois um mesmo BR pode ter apresentações distintas.
model CatmatMedicamento {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigoBr            String   @map("codigo_br") // Ex: BR0270558-2
  descricao           String?
  principioAtivo      String   @map("principio_ativo")
  concentracao        String?
  formaFarmaceutica   String?  @map("forma_farmaceutica")
  unidadeFornecimento String?  @map("unidade_fornecimento")
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm        DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)

  @@unique([codigoBr, principioAtivo, concentracao, formaFarmaceutica, unidadeFornecimento])
  @@index([codigoBr])
  @@index([principioAtivo])
  @@index([descricao])
  @@map("etl_catmat")
}

model Fornecedor {
  id            String    @id @default(uuid())
  cnpj          String    @unique
  razaoSocial   String    @map("razao_social")
  nomeFantasia  String    @map("nome_fantasia")
  email         String
  whatsapp      String
  status        String    @default("ATIVO")
  taxaAceitacao Decimal   @default(100.00) @map("taxa_aceitacao") @db.Decimal(5, 2)
  categorias    String[]
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @default(now()) @updatedAt @map("atualizado_em")
  deletedAt     DateTime? @map("deleted_at")

  // Relacionamentos
  usuarios     User[]
  atas         Ata[]          @relation("FornecedorAtas")
  pedidos      PedidoCompra[] @relation("FornecedorPedidos")
  notasFiscais NotaFiscal[]

  @@map("fornecedores")
}

model User {
  id                 String             @id @default(uuid())
  nome               String
  cpf                String?            @unique
  email              String?            @unique
  senhaHash          String             @map("senha_hash")
  role               Role               @default(COMPRADOR)
  perfil             Perfil?
  status             UsuarioStatus      @default(PENDENTE)
  unidadeId          String?            @map("unidade_id")
  unidade            Unidade?           @relation(fields: [unidadeId], references: [id])
  tenantSchema       String?            @map("tenant_schema")
  permissoesExtras   Json?              @map("permissoes_extras")
  justificativa      String?
  motivoRecusa       String?            @map("motivo_recusa")
  aprovadoPor        String?            @map("aprovado_por")
  aprovadoEm         DateTime?          @map("aprovado_em")
  fornecedorId       String?            @map("fornecedor_id")
  fornecedor         Fornecedor?        @relation(fields: [fornecedorId], references: [id])
  telefone           String?
  resetToken         String?            @map("reset_token")
  resetTokenExpiry   DateTime?          @map("reset_token_expiry")
  criadoEm           DateTime           @default(now()) @map("criado_em")
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em")
  deletedAt          DateTime?          @map("deleted_at")
  auditorias         Auditoria[]
  pedidosSolicitados PedidoReposicao[]  @relation("SolicitadoPor")
  pedidosEntregar    PedidoReposicao[]  @relation("MotoristaPedidos")
  filaCriadaPor      FilaRegulacao[]    @relation("FilaCriadaPor")
  filaAgendadaPor    FilaRegulacao[]    @relation("FilaAgendadaPor")
  viagensMotorista   ViagemTransporte[] @relation("ViagensMotorista")

  @@index([fornecedorId])
  @@index([status])
  @@map("usuarios")
}

model Ata {
  id                  String      @id @default(uuid())
  numero              String      @unique
  fornecedorNome      String      @map("fornecedor_nome") // Campo textual
  fornecedorCnpj      String?     @map("fornecedor_cnpj") // Campo textual
  fornecedor          Fornecedor? @relation("FornecedorAtas", fields: [fornecedorCnpj], references: [cnpj])
  processoLicitatorio String?     @map("processo_licitatorio")
  numeroPregao        String?     @map("numero_pregao")
  numeroEdital        String?     @map("numero_edital")
  vigenciaInicio      DateTime    @map("vigencia_inicio")
  vigenciaFim         DateTime    @map("vigencia_fim")
  valorTeto           Decimal     @map("valor_teto") @db.Decimal(12, 2)
  valorConsumido      Decimal     @default(0.00) @map("valor_consumido") @db.Decimal(12, 2)
  status              AtaStatus   @default(ATIVA)
  documentoPdfUrl     String?     @map("documento_pdf_url")
  observacoes         String?
  criadoEm            DateTime    @default(now()) @map("criado_em")
  atualizadoEm        DateTime    @updatedAt @map("atualizado_em")
  deletedAt           DateTime?   @map("deleted_at")

  medicamentos MedicamentoAta[]
  pedidos      PedidoCompra[]
  consumos     AtaConsumo[]

  @@index([fornecedorCnpj])
  @@map("atas")
}

model MedicamentoAta {
  id    String @id @default(uuid())
  ataId String @map("ata_id")
  ata   Ata    @relation(fields: [ataId], references: [id], onDelete: Cascade)

  // Integração CATMAT
  catmatCodigo        String? @map("catmat_codigo")
  nome                String
  unidadeFornecimento String? @map("unidade_fornecimento")

  // Informados manualmente na ATA
  unidadeAta    String? @map("unidade_ata")
  marca         String?
  modelo        String?
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  qtdeInicial   Int     @map("qtde_inicial")

  // Saldos e Progressos reais (atualizados sob demanda/triggers)
  quantidadeUsada Int      @default(0) @map("quantidade_usada")
  saldoAtual      Int?     @map("saldo_atual")
  valorTotalItem  Decimal? @map("valor_total_item") @db.Decimal(12, 2)

  precoBPS  Decimal? @map("preco_bps") @db.Decimal(10, 2)
  precoCMED Decimal? @map("preco_cmed") @db.Decimal(10, 2)

  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  consumos    AtaConsumo[]
  pedidoItens PedidoCompraItem[]

  @@index([ataId])
  @@map("medicamentos_ata")
}

model AtaConsumo {
  id        String         @id @default(uuid())
  ataId     String         @map("ata_id")
  ata       Ata            @relation(fields: [ataId], references: [id], onDelete: Cascade)
  ataItemId String         @map("ata_item_id")
  ataItem   MedicamentoAta @relation(fields: [ataItemId], references: [id], onDelete: Cascade)
  pedidoId  String?        @map("pedido_id") // Opcional (integração futura com módulo PedidoCompra)
  pedido    PedidoCompra?  @relation(fields: [pedidoId], references: [id])

  dataConsumo      DateTime @default(now()) @map("data_consumo")
  quantidade       Int
  valorUnitario    Decimal  @map("valor_unitario") @db.Decimal(10, 2)
  valorTotal       Decimal  @map("valor_total") @db.Decimal(12, 2)
  setorSolicitante String?  @map("setor_solicitante")
  observacao       String?
  criadoEm         DateTime @default(now()) @map("criado_em")

  @@index([ataId])
  @@index([ataItemId])
  @@index([pedidoId])
  @@map("ata_consumos")
}

model PedidoCompra {
  id              String             @id @default(uuid())
  numero          String             @unique
  status          PedidoStatus       @default(PENDENTE)
  ataId           String?            @map("ata_id")
  ata             Ata?               @relation(fields: [ataId], references: [id])
  fornecedorId    String?            @map("fornecedor_id")
  fornecedor      Fornecedor?        @relation("FornecedorPedidos", fields: [fornecedorId], references: [id])
  valorTotal      Decimal            @map("valor_total") @db.Decimal(12, 2)
  dataSolicitacao DateTime           @default(now()) @map("data_solicitacao")
  justificativa   String?
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em")
  deletedAt       DateTime?          @map("deleted_at")
  consumos        AtaConsumo[]
  itens           PedidoCompraItem[]
  notasFiscais    NotaFiscal[]

  @@index([ataId])
  @@index([status])
  @@index([fornecedorId])
  @@map("pedidos_compra")
}

model PedidoCompraItem {
  id              String          @id @default(uuid())
  pedidoId        String          @map("pedido_id")
  pedido          PedidoCompra    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  medicamentoId   String?         @map("medicamento_id")
  medicamentoNome String          @map("medicamento_nome")
  quantidade      Int
  precoUnitario   Decimal         @map("preco_unitario") @db.Decimal(10, 2)
  valorTotal      Decimal         @map("valor_total") @db.Decimal(12, 2)
  ataItemId       String?         @map("ata_item_id")
  ataItem         MedicamentoAta? @relation(fields: [ataItemId], references: [id])
  criadoEm        DateTime        @default(now()) @map("criado_em")
  atualizadoEm    DateTime        @default(now()) @updatedAt @map("atualizado_em")

  @@index([pedidoId])
  @@index([ataItemId])
  @@map("pedido_itens")
}

model Auditoria {
  id            String   @id @default(uuid())
  dataHora      DateTime @default(now()) @map("data_hora")
  usuarioId     String   @map("usuario_id")
  usuario       User     @relation(fields: [usuarioId], references: [id])
  acao          String
  entidadeId    String   @map("entidade_id")
  dadosAntes    Json?    @map("dados_antes")
  dadosDepois   Json?    @map("dados_depois")
  justificativa String?

  @@index([usuarioId])
  @@index([dataHora])
  @@map("auditorias")
}

// ─── Módulo Centro de Distribuição (CD) ──────────────────────────────────────

model NotaFiscal {
  id              String           @id @default(uuid())
  numeroNf        String           @map("numero_nf")
  serie           String
  chaveAcesso     String?          @unique @map("chave_acesso")
  dataEmissao     DateTime         @map("data_emissao")
  dataRecebimento DateTime?        @map("data_recebimento")
  fornecedorId    String           @map("fornecedor_id")
  fornecedor      Fornecedor       @relation(fields: [fornecedorId], references: [id])
  pedidoCompraId  String?          @map("pedido_compra_id")
  pedidoCompra    PedidoCompra?    @relation(fields: [pedidoCompraId], references: [id])
  status          NotaFiscalStatus @default(PENDENTE)
  valorTotal      Decimal          @map("valor_total") @db.Decimal(12, 2)
  xmlUrl          String?          @map("xml_url")
  observacoes     String?
  conferidoPor    String?          @map("conferido_por")
  conferidoEm     DateTime?        @map("conferido_em")
  criadoEm        DateTime         @default(now()) @map("criado_em")
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em")
  deletedAt       DateTime?        @map("deleted_at")

  itens NotaFiscalItem[]

  @@index([fornecedorId])
  @@index([pedidoCompraId])
  @@index([status])
  @@map("notas_fiscais")
}

model NotaFiscalItem {
  id                    String     @id @default(uuid())
  notaFiscalId          String     @map("nota_fiscal_id")
  notaFiscal            NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  catmatCodigo          String?    @map("catmat_codigo")
  medicamentoNome       String     @map("medicamento_nome")
  numeroLote            String     @map("numero_lote")
  dataValidade          DateTime   @map("data_validade") @db.Date
  quantidadeEsperada    Int        @map("quantidade_esperada")
  quantidadeRecebida    Int?       @map("quantidade_recebida")
  precoUnitario         Decimal    @map("preco_unitario") @db.Decimal(10, 2)
  divergencia           Boolean    @default(false)
  observacaoDivergencia String?    @map("observacao_divergencia")
  criadoEm              DateTime   @default(now()) @map("criado_em")

  estoqueLote CdEstoqueLote?

  @@index([notaFiscalId])
  @@index([catmatCodigo])
  @@map("nota_fiscal_itens")
}

model CdEstoqueLote {
  id                String              @id @default(uuid())
  notaFiscalItemId  String              @unique @map("nota_fiscal_item_id")
  notaFiscalItem    NotaFiscalItem      @relation(fields: [notaFiscalItemId], references: [id])
  catmatCodigo      String?             @map("catmat_codigo")
  medicamentoNome   String              @map("medicamento_nome")
  numeroLote        String              @map("numero_lote")
  dataValidade      DateTime            @map("data_validade") @db.Date
  quantidadeInicial Int                 @map("quantidade_inicial")
  quantidadeAtual   Int                 @map("quantidade_atual")
  status            CdEstoqueLoteStatus @default(DISPONIVEL)
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @updatedAt @map("atualizado_em")
  deletedAt         DateTime?           @map("deleted_at")

  @@index([catmatCodigo, numeroLote])
  @@index([status])
  @@map("cd_estoque_lotes")
}

model Recall {
  id                 String    @id @default(uuid())
  catmatCodigo       String?   @map("catmat_codigo")
  numeroLote         String?   @map("numero_lote")
  medicamentoNome    String?   @map("medicamento_nome")
  fonte              String?   @default("ANVISA")
  risco              String?
  motivo             String
  autoridadeEmissora String?   @map("autoridade_emissora")
  numeroAnvisa       String?   @map("numero_anvisa")
  dataEmissao        DateTime  @default(now()) @map("data_emissao")
  dataExpiracao      DateTime? @map("data_expiracao")
  ativo              Boolean   @default(true)
  criadoPor          String    @map("criado_por")
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em")

  @@index([catmatCodigo, numeroLote])
  @@index([ativo])
  @@map("recalls")
}

model AlertaCd {
  id                  String         @id @default(uuid())
  tipo                AlertaCdTipo
  referenciaId        String         @map("referencia_id")
  referenciaTipo      String         @map("referencia_tipo")
  titulo              String
  descricao           String
  status              AlertaCdStatus @default(NOVO)
  perfisDestinatarios String[]       @map("perfis_destinatarios")
  criadoEm            DateTime       @default(now()) @map("criado_em")
  lidoEm              DateTime?      @map("lido_em")
  lidoPor             String?        @map("lido_por")

  @@index([status])
  @@index([tipo])
  @@map("alertas_cd")
}

model CdEstoqueMinimo {
  id               String   @id @default(uuid())
  medicamentoNome  String   @unique @map("medicamento_nome")
  catmatCodigo     String?  @map("catmat_codigo")
  quantidadeMinima Int      @default(0) @map("quantidade_minima")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")
  criadoEm         DateTime @default(now()) @map("criado_em")

  @@map("cd_estoque_minimo")
}

enum PedidoReposicaoStatus {
  PENDENTE
  EM_ANALISE
  EM_SEPARACAO
  AGUARDANDO_MOTORISTA
  EM_TRANSITO
  CONCLUIDO
  REJEITADO
}

enum PedidoReposicaoUrgencia {
  BAIXA
  MEDIA
  ALTA
}

enum TipoUnidade {
  UBS
  USF
  UPA
  FARMACIA_MUNICIPAL
  POSTO_SAUDE
}

model Unidade {
  id           String      @id @default(uuid())
  nome         String
  cnes         String?     @unique
  tipo         TipoUnidade @default(UBS)
  endereco     String?
  telefone     String?
  email        String?
  responsavel  String?
  cep          String?
  logradouro   String?
  numero       String?
  bairro       String?
  cidade       String?
  uf           String?
  tenantSchema String      @unique @map("tenant_schema")
  ativa        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime    @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)

  usuarios       User[]
  pedidos        PedidoReposicao[]
  filasRegulacao FilaRegulacao[]
  pacientes      Paciente[]

  @@map("unidades")
}

model PedidoReposicao {
  id              String                  @id @default(uuid())
  numero          String                  @unique // Ex: PED-2026-0001
  status          PedidoReposicaoStatus   @default(PENDENTE)
  urgencia        PedidoReposicaoUrgencia @default(BAIXA)
  unidadeId       String                  @map("unidade_id")
  unidade         Unidade                 @relation(fields: [unidadeId], references: [id])
  solicitadoPorId String                  @map("solicitado_por_id")
  solicitadoPor   User                    @relation("SolicitadoPor", fields: [solicitadoPorId], references: [id])

  motoristaId String? @map("motorista_id")
  motorista   User?   @relation("MotoristaPedidos", fields: [motoristaId], references: [id])

  justificativa  String?
  motivoRejeicao String? @map("motivo_rejeicao")

  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletedAt    DateTime? @map("deleted_at")

  itens PedidoReposicaoItem[]

  @@index([unidadeId])
  @@index([status])
  @@index([motoristaId])
  @@map("pedidos_reposicao")
}

model PedidoReposicaoItem {
  id       String          @id @default(uuid())
  pedidoId String          @map("pedido_id")
  pedido   PedidoReposicao @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  catmatCodigo    String? @map("catmat_codigo")
  medicamentoNome String  @map("medicamento_nome")
  quantidade      Int

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([pedidoId])
  @@index([catmatCodigo])
  @@map("pedido_reposicao_itens")
}

model Paciente {
  id                  String   @id @default(uuid())
  prontuario          String   @unique
  cpf                 String   @unique
  cartaoSus           String?  @map("cartao_sus")
  nomeCompleto        String   @map("nome_completo")
  dataNascimento      DateTime @map("data_nascimento") @db.Date
  sexo                Sexo
  orientacaoSexual    String?  @map("orientacao_sexual")
  identidadeGenero    String?  @map("identidade_genero")
  nomeSocial          String?  @map("nome_social")
  municipioNascimento String?  @map("municipio_nascimento")
  nacionalidade       String   @default("BRASILEIRA")
  paisNascimento      String   @default("BRASIL") @map("pais_nascimento")
  corRaca             String   @default("Não informada") @map("cor_raca")
  etnia               String?
  tipoSanguineo       String?  @map("tipo_sanguineo")
  prontuariosAntigos  String?  @map("prontuarios_antigos")
  alergias            String?
  familia             String?
  area                String?
  subarea             String?
  escolaridade        String?

  celular         String  @default("")
  telefone        String?
  email           String?
  nomeMae         String? @map("nome_mae")
  maeDesconhecida Boolean @default(false) @map("mae_desconhecida")
  nomePai         String? @map("nome_pai")
  paiDesconhecido Boolean @default(false) @map("pai_desconhecido")

  rg                 String?
  orgaoEmissor       String?   @map("orgao_emissor")
  ufRg               String?   @map("uf_rg")
  dataExpedicaoRg    DateTime? @map("data_expedicao_rg") @db.Date
  nis                String?
  certidaoNascimento String?   @map("certidao_nascimento")
  dataObito          DateTime? @map("data_obito") @db.Date
  tituloEleitor      String?   @map("titulo_eleitor")
  estadoCivil        String?   @map("estado_civil")
  funcionarioExterno Boolean   @default(false) @map("funcionario_externo")
  observacao         String?
  profissaoCbo       String?   @map("profissao_cbo")
  localTrabalho      String?   @map("local_trabalho")

  situacaoRua    Boolean @default(false) @map("situacao_rua")
  cep            String
  tipoLogradouro String  @default("RUA") @map("tipo_logradouro")
  logradouro     String
  numero         String
  bairro         String
  complemento    String?
  municipio      String
  localizacao    String  @default("URBANA")

  unidadeOrigemId String?  @map("unidade_origem_id")
  unidadeOrigem   Unidade? @relation(fields: [unidadeOrigemId], references: [id])

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Score de confiabilidade / absenteísmo (0-100, padrão 100)
  scoreConfianca Int @default(100) @map("score_confianca")

  fichasRegulacao      FilaRegulacao[]
  viagensPassageiro    ViagemPassageiro[]
  historicoAbsenteismo HistoricoAbsenteismo[]

  @@index([unidadeOrigemId])
  @@map("pacientes")
}

model FilaRegulacao {
  id String @id @default(uuid())

  // Dados da Unidade e Responsáveis
  unidadeEsfId              String  @map("unidade_esf_id")
  unidadeEsf                Unidade @relation(fields: [unidadeEsfId], references: [id])
  responsavelEncaminhamento String  @map("responsavel_encaminhamento")
  acsResponsavel            String  @map("acs_responsavel")

  // Relação com Paciente
  pacienteId      String          @map("paciente_id")
  paciente        Paciente        @relation(fields: [pacienteId], references: [id])
  tipoAtendimento TipoAtendimento @default(SUS) @map("tipo_atendimento")

  // Dados Clínicos e Anexos
  procedimentoSolicitado String  @map("procedimento_solicitado")
  observacaoClinica      String? @map("observacao_clinica")
  anexoUrl               String? @map("anexo_url")

  // Dados de Agendamento (Secretaria)
  dataAgendada     DateTime? @map("data_agendada") @db.Date
  horaAgendada     String?   @map("hora_agendada")
  localAgendamento String?   @map("local_agendamento")

  // Controle de Fluxo
  statusAgendamento StatusAgendamento @default(AGUARDANDO_REGULACAO) @map("status_agendamento")

  // Auditoria
  criadoPorUsuarioId   String  @map("criado_por_usuario_id")
  criadoPor            User    @relation("FilaCriadaPor", fields: [criadoPorUsuarioId], references: [id])
  agendadoPorUsuarioId String? @map("agendado_por_usuario_id")
  agendadoPor          User?   @relation("FilaAgendadaPor", fields: [agendadoPorUsuarioId], references: [id])

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([unidadeEsfId])
  @@index([statusAgendamento])
  @@index([pacienteId])
  @@index([criadoPorUsuarioId])
  @@map("fila_regulacao")
}

// Removido: model PermissoesPerfil / tabela permissoes_perfil.
// Nunca foi lido nem escrito pelo código — a autorização real acontece em
// roleMiddleware() (arrays de perfis nas rotas) + usuarios.permissoes_extras.

// ==========================================
// Módulo de Confirmação de Filas via WhatsApp (Migração PontaPoraSaude)
// ==========================================

enum ImportStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum QueueEntryStatus {
  PENDING
  AWAITING_RESPONSE
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

// ------------------------------------------------------------------
// Confirmação Automatizada de Agendamentos (ciclo de confirmação)
// ------------------------------------------------------------------

// Situação do paciente dentro da fila de confirmação
enum PacienteFilaStatus {
  AGUARDANDO // Na fila, nunca convocado
  CONVOCADO // Mensagem enviada, aguardando resposta
  CONFIRMADO // Confirmou presença (passou por todas as etapas)
  RECONFIRMADO // Reconfirmou na última etapa
  RECUSOU // Recusou em alguma etapa
  NAO_RESPONDEU // Timeout após todas as tentativas de reenvio
  CANCELADO // Cancelado manualmente pelo regulador
}

// Nível de urgência usado na ordenação da convocação
enum NivelUrgencia {
  NORMAL
  AMARELO
  VERMELHO
}

// Motivos pré-definidos de recusa (seção 4.3)
enum MotivoRecusa {
  MELHORA_SINTOMAS
  SEM_TRANSPORTE
  COMPROMISSO_TRABALHO
  PROBLEMAS_FAMILIARES
  JA_CONSULTOU_PARTICULAR
  OUTRO
}

// Situação de um ciclo/etapa de confirmação individual
enum CicloStatus {
  CONVOCADO // Mensagem enviada, aguardando resposta do paciente
  CONFIRMADO // Paciente respondeu SIM
  RECUSADO // Paciente respondeu NÃO
  EXPIRADO // Timeout sem resposta
}

model PdfImport {
  id               String         @id @default(uuid())
  storagePath      String         @map("storage_path")
  originalFilename String?        @map("original_filename")
  fileData         Bytes?         @map("file_data")
  status           ImportStatus   @default(PENDING)
  rowsFound        Int?           @map("rows_found")
  rowsImported     Int?           @map("rows_imported")
  errorLog         String?        @map("error_log")
  processedAt      DateTime?      @map("processed_at")
  criadoEm         DateTime       @default(now()) @map("criado_em")
  rows             PdfImportRow[]
  queueEntries     QueueEntry[]

  @@map("pdf_imports")
}

model PdfImportRow {
  id           String    @id @default(uuid())
  importId     String    @map("import_id")
  import       PdfImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rawData      Json      @map("raw_data")
  pacienteId   String?   @map("paciente_id")
  queueEntryId String?   @map("queue_entry_id")
  error        String?
  approved     Boolean   @default(false)
  criadoEm     DateTime  @default(now()) @map("criado_em")

  @@index([importId])
  @@map("pdf_import_rows")
}

model QueueEntry {
  id             String           @id @default(uuid())
  pacienteId     String           @map("paciente_id")
  procedimentoId String?          @map("procedimento_id")
  importId       String?          @map("import_id")
  import         PdfImport?       @relation(fields: [importId], references: [id])
  posicao        Int
  status         QueueEntryStatus @default(PENDING)
  dataAgendada   DateTime?        @map("data_agendada") @db.Date
  notificadoEm   DateTime?        @map("notificado_em")
  respondidoEm   DateTime?        @map("respondido_em")
  expiraEm       DateTime?        @map("expira_em")
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")
  messages       MessageLog[]

  // Módulo de Confirmação Automatizada
  unidadeId        String?            @map("unidade_id") // escopo por município (row-level)
  statusPaciente   PacienteFilaStatus @default(AGUARDANDO) @map("status_paciente")
  nivelUrgencia    NivelUrgencia      @default(NORMAL) @map("nivel_urgencia")
  procedimentoNome String?            @map("procedimento_nome") // nome legível p/ agrupar a fila
  ciclos           CicloConfirmacao[]

  @@index([procedimentoId, status, posicao])
  @@index([pacienteId])
  @@index([unidadeId, statusPaciente, nivelUrgencia, posicao])
  @@map("queue_entries")
}

model MessageLog {
  id           String           @id @default(uuid())
  queueEntryId String?          @map("queue_entry_id")
  queueEntry   QueueEntry?      @relation(fields: [queueEntryId], references: [id])
  pacienteId   String?          @map("paciente_id")
  direction    MessageDirection
  wamid        String?
  templateName String?          @map("template_name")
  body         String?
  status       MessageStatus    @default(QUEUED)
  rawPayload   Json?            @map("raw_payload")
  error        String?
  criadoEm     DateTime         @default(now()) @map("criado_em")

  @@index([queueEntryId])
  @@index([wamid])
  @@map("messages_log")
}

// Cada etapa/ciclo de confirmação disparado para uma entrada da fila.
// É o que o cron de timeout (regra 7.1) varre por expiraEm < agora.
model CicloConfirmacao {
  id               String        @id @default(uuid())
  queueEntryId     String        @map("queue_entry_id")
  queueEntry       QueueEntry    @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  unidadeId        String?       @map("unidade_id")
  etapa            Int // 1 = confirmação inicial, 2 = reconfirmação, ...
  tentativa        Int           @default(1) // nº de disparos desta etapa (reenvios)
  status           CicloStatus   @default(CONVOCADO)
  templateName     String        @map("template_name")
  callbackId       String        @unique @map("callback_id") // uuid correlacionado no callback do ChatBot
  messageId        String?       @map("message_id") // id devolvido pelo gateway
  enviadoEm        DateTime      @default(now()) @map("enviado_em")
  expiraEm         DateTime      @map("expira_em")
  respondidoEm     DateTime?     @map("respondido_em")
  resposta         String? // "SIM" | "NAO"
  motivoRecusa     MotivoRecusa? @map("motivo_recusa")
  motivoTextoLivre String?       @map("motivo_texto_livre")
  criadoEm         DateTime      @default(now()) @map("criado_em")

  @@index([queueEntryId])
  @@index([status, expiraEm])
  @@index([callbackId])
  @@map("ciclos_confirmacao")
}

// Configurações do módulo de confirmação por município (seção 4.9).
model ConfiguracaoRegulacao {
  id                    String   @id @default(uuid())
  unidadeId             String   @unique @map("unidade_id")
  qtdConfirmacoes       Int      @default(2) @map("qtd_confirmacoes")
  diasAntesConfirmacao  Int[]    @default([7, 1]) @map("dias_antes_confirmacao")
  qtdReenvios           Int      @default(2) @map("qtd_reenvios")
  intervaloReenvioHoras Int      @default(12) @map("intervalo_reenvio_horas")
  timeoutRespostaHoras  Int      @default(24) @map("timeout_resposta_horas")
  horarioInicio         String   @default("07:00") @map("horario_inicio")
  horarioFim            String   @default("20:00") @map("horario_fim")
  timezone              String   @default("America/Campo_Grande")
  templateConfirmacao   String   @default("confirmacao_agendamento") @map("template_confirmacao")
  templateReconfirmacao String   @default("reconfirmacao_agendamento") @map("template_reconfirmacao")
  templateColetaMotivo  String   @default("coleta_motivo_recusa") @map("template_coleta_motivo")
  templateConvocacao    String   @default("convocacao_vaga") @map("template_convocacao")
  criadoEm              DateTime @default(now()) @map("criado_em")
  atualizadoEm          DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes_regulacao")
}

// Histórico de desfechos que alimentam o score de absenteísmo (seção 4.7).
model HistoricoAbsenteismo {
  id              String   @id @default(uuid())
  pacienteId      String   @map("paciente_id")
  paciente        Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  unidadeId       String?  @map("unidade_id")
  queueEntryId    String?  @map("queue_entry_id")
  tipo            String // CONFIRMOU | RECUSOU | NAO_RESPONDEU
  motivo          String?
  delta           Int // variação aplicada ao score
  scoreResultante Int      @map("score_resultante")
  criadoEm        DateTime @default(now()) @map("criado_em")

  @@index([pacienteId])
  @@map("historico_absenteismo")
}

// Capacidade/vagas por procedimento/dia de um município (seção 4.8).
model SlotAgenda {
  id              String   @id @default(uuid())
  unidadeId       String   @map("unidade_id")
  procedimento    String
  data            DateTime @db.Date
  capacidadeTotal Int      @map("capacidade_total")
  origem          String   @default("MANUAL") // MANUAL | PDF
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@unique([unidadeId, procedimento, data])
  @@index([unidadeId, data])
  @@map("slots_agenda")
}

enum ViagemStatus {
  AGENDADA
  SAIDA_CIDADE
  CHEGADA_DESTINO
  RETORNO_DESTINO
  CONCLUIDA
  CANCELADA
}

enum PassageiroStatus {
  PENDENTE
  EMBARCOU
  NAO_COMPARECEU
  DESEMBARCOU
}

model ViagemTransporte {
  id          String       @id @default(uuid())
  motoristaId String       @map("motorista_id")
  motorista   User         @relation("ViagensMotorista", fields: [motoristaId], references: [id])
  veiculo     String
  placa       String?
  origem      String       @default("UBS Central / Regulação")
  destino     String
  dataViagem  DateTime     @map("data_viagem")
  status      ViagemStatus @default(AGENDADA)

  // 4 Etapas da Jornada
  saidaOrigemEm    DateTime? @map("saida_origem_em")
  chegadaDestinoEm DateTime? @map("chegada_destino_em")
  saidaDestinoEm   DateTime? @map("saida_destino_em")
  chegadaOrigemEm  DateTime? @map("chegada_origem_em")

  // Rastreamento GPS
  gpsInicioLat Float? @map("gps_inicio_lat")
  gpsInicioLng Float? @map("gps_inicio_lng")
  gpsFimLat    Float? @map("gps_fim_lat")
  gpsFimLng    Float? @map("gps_fim_lng")
  gpsPontos    Json?  @map("gps_pontos") // Array de [{ lat, lng, timestamp, precisao, etapa }]

  // Confirmação e Assinatura Digital do Motorista/Equipe
  assinaturaBase64 String? @map("assinatura_base64")
  observacoes      String?

  iniciadaEm   DateTime? @map("iniciada_em")
  concluidaEm  DateTime? @map("concluida_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  passageiros ViagemPassageiro[]

  @@index([motoristaId])
  @@index([status])
  @@map("viagens_transporte")
}

model ViagemPassageiro {
  id             String           @id @default(uuid())
  viagemId       String           @map("viagem_id")
  viagem         ViagemTransporte @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  pacienteId     String?          @map("paciente_id")
  paciente       Paciente?        @relation(fields: [pacienteId], references: [id])
  nomePaciente   String           @map("nome_paciente")
  cartaoSus      String?          @map("cartao_sus")
  acompanhante   String?
  status         PassageiroStatus @default(PENDENTE)
  motivoAusencia String?          @map("motivo_ausencia")

  @@index([viagemId])
  @@index([pacienteId])
  @@map("viagem_passageiros")
}
