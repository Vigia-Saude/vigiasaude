// Schema das tabelas presentes em cada tenant_farmacia_x.
// Usado apenas como referência de tipos — o PrismaClientFactory
// aponta o search_path dinamicamente via DATABASE_URL_DIRECT.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

model Medicamento {
  id                     String               @id @default(cuid())
  catmatCodigo           String?
  nome                   String
  principioAtivo         String?
  formaFarmaceutica      String?
  concentracao           String?
  unidadeMedida          String               @default("UNIDADE")
  quantidadePorEmbalagem Int                  @default(1) @map("quantidade_por_embalagem")
  estoqueMinimo          Int                  @default(0)
  criadoEm               DateTime             @default(now())
  atualizadoEm           DateTime             @updatedAt
  deletedAt              DateTime?

  lotes                 Lote[]
  dispensacaoItens      DispensacaoItem[]
  embalagensFracionadas EmbalageFracionada[]

  @@map("medicamentos")
}

model Lote {
  id                       String               @id @default(cuid())
  medicamentoId            String
  medicamento              Medicamento          @relation(fields: [medicamentoId], references: [id])
  numeroLote               String
  quantidade               Int
  quantidadeAtual          Int
  quantidadeCaixasFechadas Int                  @default(0) @map("quantidade_caixas_fechadas")
  quantidadePorCaixa       Int                  @default(1) @map("quantidade_por_caixa")
  validade                 DateTime             @db.Date
  fornecedor               String?
  notaFiscal               String?
  criadoEm                 DateTime             @default(now())
  deletedAt                DateTime?

  dispensacaoItens      DispensacaoItem[]
  embalagensFracionadas EmbalageFracionada[]

  @@map("lotes")
}

model Paciente {
  id           String    @id @default(cuid())
  nome         String
  cpf          String?   @unique
  cartaoSus    String?   @unique
  dataNasc     DateTime? @db.Date
  telefone     String?
  endereco     String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletedAt    DateTime?

  prescricoes  Prescricao[]
  dispensacoes Dispensacao[]

  @@map("pacientes")
}

model Prescricao {
  id            String    @id @default(cuid())
  pacienteId    String
  paciente      Paciente  @relation(fields: [pacienteId], references: [id])
  medicoNome    String?
  crm           String?
  dataEmissao   DateTime  @db.Date
  dataValidade  DateTime? @db.Date
  numeroReceita String?
  arquivoUrl    String?
  observacoes   String?
  criadoEm      DateTime  @default(now())
  deletedAt     DateTime?

  dispensacoes  Dispensacao[]

  @@map("prescricoes")
}

model Dispensacao {
  id               String      @id @default(cuid())
  pacienteId       String
  paciente         Paciente    @relation(fields: [pacienteId], references: [id])
  prescricaoId     String?
  prescricao       Prescricao? @relation(fields: [prescricaoId], references: [id])
  usuarioId        String
  dataDispensacao  DateTime    @default(now())
  observacoes      String?
  criadoEm         DateTime    @default(now())

  itens            DispensacaoItem[]

  @@map("dispensacoes")
}

model DispensacaoItem {
  id                    String              @id @default(cuid())
  dispensacaoId         String
  dispensacao           Dispensacao         @relation(fields: [dispensacaoId], references: [id])
  medicamentoId         String
  medicamento           Medicamento         @relation(fields: [medicamentoId], references: [id])
  loteId                String?
  lote                  Lote?               @relation(fields: [loteId], references: [id])
  embalagemFracionadaId String?             @map("embalagem_fracionada_id")
  embalagem             EmbalageFracionada? @relation(fields: [embalagemFracionadaId], references: [id])
  quantidade            Int
  criadoEm              DateTime            @default(now())

  @@map("dispensacao_itens")
}

model EmbalageFracionada {
  id              String   @id @default(cuid())
  loteId          String   @map("lote_id")
  lote            Lote     @relation(fields: [loteId], references: [id])
  medicamentoId   String   @map("medicamento_id")
  medicamento     Medicamento @relation(fields: [medicamentoId], references: [id])
  codigoQr        String   @unique @map("codigo_qr")
  quantidadeAtual Int      @map("quantidade_atual")
  status          String   @default("ATIVO")  // ATIVO, ESGOTADO
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  criadoPor       String   @map("criado_por")

  dispensacaoItens DispensacaoItem[]
  movimentacoes    MovimentacaoFracionada[]

  @@map("embalagens_fracionadas")
}

/// Entrega domiciliar de medicamento dispensado pela farmácia.
/// Consultada por SQL cru em FarmaciaController — declarada aqui para que o
/// schema reflita o que existe no banco e o `db push` não a remova.
model EntregaDomiciliar {
  id             String    @id @default(cuid())
  numero         String
  status         String    @default("PENDENTE")
  prioridade     String    @default("NORMAL")
  pacienteId     String?   @map("paciente_id")
  pacienteNome   String    @map("paciente_nome")
  pacienteCpf    String?   @map("paciente_cpf")
  endereco       String
  entregadorNome String?   @map("entregador_nome")
  codigoRastreio String?   @map("codigo_rastreio")
  observacoes    String?
  criadoPor      String    @map("criado_por")
  criadoEm       DateTime? @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime? @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  itens EntregaItem[]

  @@map("entregas_domiciliares")
}

model EntregaItem {
  id              String            @id @default(cuid())
  entregaId       String            @map("entrega_id")
  entrega         EntregaDomiciliar @relation(fields: [entregaId], references: [id])
  medicamentoId   String            @map("medicamento_id")
  medicamentoNome String            @map("medicamento_nome")
  loteId          String?           @map("lote_id")
  numeroLote      String?           @map("numero_lote")
  quantidade      Int
  criadoEm        DateTime?         @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entregaId])
  @@map("entrega_itens")
}

model MovimentacaoFracionada {
  id                    String   @id @default(cuid())
  embalagemFracionadaId String   @map("embalagem_fracionada_id")
  embalagem             EmbalageFracionada @relation(fields: [embalagemFracionadaId], references: [id])
  tipo                  String   // CRIACAO, DISPENSACAO, REPOSICAO, INVENTARIO, AJUSTE
  quantidadeAnterior    Int      @map("quantidade_anterior")
  quantidadeMovimentada Int      @map("quantidade_movimentada")
  quantidadeResultante  Int      @map("quantidade_resultante")
  codigoQrAnterior      String?  @map("codigo_qr_anterior")
  codigoQrNovo          String?  @map("codigo_qr_novo")
  usuarioId             String   @map("usuario_id")
  observacao            String?
  criadoEm              DateTime @default(now()) @map("criado_em")

  @@map("movimentacoes_fracionadas")
}
