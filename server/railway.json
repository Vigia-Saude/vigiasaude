{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "npm install --include=dev && npx prisma generate && npx tsc"
  },
  "deploy": {
    "startCommand": "node --dns-result-order=ipv4first dist/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
