# === Supabase Database ===
# Transaction Mode (Porta 6543) - Usado pela aplicação para queries
DATABASE_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Mode (Porta 5432) - Usado pelo Prisma para rodar migrations
DIRECT_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Conexão direta ao host (sem pooler) - Usado pelo PrismaFactory para schemas tenant dinâmicos
# Substitua [SEU_PROJECT_REF] pelo ref do projeto Supabase (ex: oxanubfolkoulklrhrpr)
DATABASE_URL_DIRECT="postgresql://postgres.[SEU_PROJECT_REF]:[SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres"

# === Supabase API ===
SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# === Servidor ===
PORT=3001
NODE_ENV=development

# === CORS ===
# Em produção, defina a URL do frontend separada por vírgula
# CORS_ORIGIN=https://vigiasaude.vercel.app,https://vigiasaude.com.br

# === JWT ===
JWT_SECRET=sua_chave_secreta_aqui

# === Módulo de Confirmação Automatizada (WhatsApp) ===
# Gateway de mensagens: "mock" (padrão nesta fase — loga no console e em MessageLog)
# ou "chatbot" (integração real com o ChatBot Vinhedo — fase futura, ainda stub).
MESSAGING_GATEWAY=mock
# Integração futura com o ChatBot Vinhedo (contrato da seção 5):
# CHATBOT_URL=https://chatbot.municipio.gov.br
# CHATBOT_API_KEY=chave_por_municipio_aqui
# Segredo compartilhado do callback (verificação simples; HMAC real = fase futura).
# Se definido, o callback exige o header X-Webhook-Secret com este valor.
# VIGIA_WEBHOOK_SECRET=segredo_do_webhook_aqui
# Timezone dos cron jobs de confirmação (padrão America/Campo_Grande).
# CRON_TIMEZONE=America/Campo_Grande
# Desabilita os cron jobs de confirmação (ex.: testes ou múltiplas instâncias).
# CONFIRMACAO_CRON_ENABLED=false

# === WhatsApp / Meta Cloud API (legado — substituído pelo gateway acima) ===
# Mantidos para o webhook Meta existente (/webhooks/whatsapp).
# WHATSAPP_TOKEN=seu_token_meta_aqui
# WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui
# WHATSAPP_TEMPLATE_CONFIRMATION=confirmacao_agendamento
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=ppsaude-webhook-2026
